<mxfile host="app.diagrams.net">
  <diagram name="Scope model: the two child-binding paths">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="parent" value="Parent kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="spawn" value="Spawn binder&lt;br&gt;(materialize_wiring_from_outer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="trav" value="Traversal cascade" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="320" width="240" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="child1" value="Interpreter child" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1000" y="40" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="child2" value="Child on the engine&lt;br&gt;the host asks for" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1000" y="320" width="220" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="rounded=0;html=1;endArrow=block;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="parent" target="spawn">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="80"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" style="rounded=0;html=1;endArrow=block;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="parent" target="trav">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="360"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="l1" value="spawn or build_subscope" style="text;html=1;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="56" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="l2" value="traverse, then activation_on" style="text;html=1;align=center;verticalAlign=bottom;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="160" y="336" width="240" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="shared and transit cells, output cells,&lt;br&gt;value copies, scope-init pulls,&lt;br&gt;coordinate path" style="rounded=0;html=1;fontSize=12;endArrow=block;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="spawn" target="child1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-4" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4" value="tuple elements and cascaded wires&lt;br&gt;by value (set_input);&lt;br&gt;cursors narrowed (set_cursor)" style="rounded=0;html=1;fontSize=12;endArrow=block;verticalAlign=bottom;labelBackgroundColor=none;" edge="1" parent="1" source="trav" target="child2">
