<mxfile host="app.diagrams.net">
  <diagram name="One slot call">
    <mxGraphModel dx="800" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="420" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s1" value="Native code gathers the step's input slots into an array in its frame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="Native code calls jit_slot_call with the kit, the input and output arrays, the state's scratch, and the step's first entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="The kit runs the node's body on the inputs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="The kit writes each by-reference result into the step's own scratch entry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="290" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="The kit publishes each result's (pointer, length) pair into the output array" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s6" value="Native code scatters the output array into the step's output slots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="320" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1" source="s5" target="s6">
