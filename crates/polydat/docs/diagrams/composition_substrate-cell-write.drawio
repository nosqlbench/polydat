<mxfile host="app.diagrams.net">
  <diagram name="SharedCell write and cross-fiber observation">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="700" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="lp" value="Producer kernel (fiber A)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lc" value="SharedCell" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="250" y="20" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lk" value="Consumer kernel (fiber B)" style="text;html=1;align=center;verticalAlign=middle;fontStyle=1;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="460" y="20" width="200" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="s1" value="1. Writes a value to the cell-bound input, under the cell's Mutex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s2" value="2. Publishes the value, increments the revision, and sets the cell's bit on the intent word of the scope that created it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="250" y="190" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="3. Next read: the interpreter's revision check, or a compiled engine's per-cell poll, sees the revision has moved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="330" width="200" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="s4" value="4. Marks every step that reads the cell's slot not current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="470" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="s5" value="5. The pull re-runs those steps with the published value" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="590" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note" value="No host-side refresh call is made at any step." style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="400" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
